# ==========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ==========================================
APP_NAME="Sistema de Chamados - CGTI/SEAD"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://chamados.saogoncalo.ce.gov.br
APP_TIMEZONE=America/Fortaleza

# ATENÇÃO AO APP_BASE_PATH:
# Se o sistema for acessado pela raiz (ex: chamados.saogoncalo.ce.gov.br), deixe vazio.
# Se for acessado numa subpasta (ex: saogoncalo.ce.gov.br/chamados), coloque "/chamados".
APP_BASE_PATH=""

# Código para liberar o cadastro de novos usuários
APP_EMPRESA_CODIGO=SEAD2026

# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
